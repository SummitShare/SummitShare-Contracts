{
  "name": "@rev-share/contracts",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "postinstall": "chmod +x sync-abis.js && chmod +x scripts/deploy-handler.sh",
    "test": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage --solcoverjs ./.solcover.js --temp build/contracts --testfiles \"./test/*.ts\"",
    "build": "hardhat compile && node sync-abis.js",
    "deploy:dev": "hardhat run --network sepolia scripts/deploy.ts",
    "configure:dev": "hardhat run --network sepolia scripts/configure.ts",
    "deploy:prod": "hardhat run --network optimism scripts/deploy.ts",
    "configure:prod": "hardhat run --network optimism scripts/configure.ts",
    "mock:dev": "hardhat run --network scripts/mock.ts",
    "sync:abis": "node sync-abis.js",
    
    "deploy:handler:dev": "scripts/deploy-handler.sh dev",
    "deploy:handler:prod": "scripts/deploy-handler.sh prod",
    "deploy:handler": "scripts/deploy-handler.sh",
    
    "test:deployment": "hardhat run scripts/test-deployment.ts",
    "test:deployment:sepolia": "hardhat run --network sepolia scripts/test-deployment.ts",
    "test:deployment:optimism": "hardhat run --network optimismSepolia scripts/test-deployment.ts",
    "test:deployment:base": "hardhat run --network baseSepolia scripts/test-deployment.ts",
    "test:deployment:all": "yarn test:deployment:sepolia && yarn test:deployment:optimism && yarn test:deployment:base"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "@openzeppelin/hardhat-upgrades": "^3.0.2",
    "@typechain/ethers-v6": "^0.4.0",
    "@typechain/hardhat": "^8.0.0",
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.8.7",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "erc721a": "^4.2.3",
    "ethers": "^6.13.1",
    "hardhat": "^2.22.6",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.1",
    "typechain": "^8.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-verify": "^2.0.8",
    "@openzeppelin/contracts": "^5.0.0"
  }
}
